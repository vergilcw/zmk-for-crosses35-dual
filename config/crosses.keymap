/*
 * Crosses 35 dual-trackball keymap.
 *
 * Bindings were exported from the keyboard's ZMK Studio state on 2026-10-10
 * (scripts/studio_dump.py -> scripts/studio_to_keymap.py; raw snapshot in
 * docs/studio-snapshots/). Studio-saved bindings in flash override this file
 * until "Restore Stock Settings" is run in ZMK Studio — see docs/flashing.md.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors/rotate_plane.dtsi>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define MOUSE 3

&zip_rotate_pointer {
    angle = <45>; /* +45 here == "-45 / counterclockwise" in the Crosses 36 repo */
};

&trackball_central_listener {
    input-processors = <&zip_rotate_pointer>;
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    /*
     * Right (central) trackball: rotated 45 deg counterclockwise, then per layer
     *   Base/Mouse: pointer    Lower: scroll    Raise: snipe (1/4 speed)
     * Stage 1 (trackball_central_listener, defined in the shield) only rotates; stage 2 reads the
     * rotated events from the processor device and applies the layer behaviour.
     * The left trackball is untouched (always scroll, see the shield).
     */
    rotated_pointer_listener {
        compatible = "zmk,input-listener";
        device = <&zip_rotate_pointer>;
        input-processors = <&zip_ble_report_rate_limit>;

        lower_scroll {
            layers = <LOWER>;
            input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 2>, <&zip_ble_report_rate_limit>;
        };

        raise_snipe {
            layers = <RAISE>;
            input-processors = <&zip_xy_scaler 1 4>, <&zip_ble_report_rate_limit>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q           &kp W            &kp E  &kp R  &kp T  &kp Y  &kp U        &kp I      &kp O          &kp P
&kp A           &kp S            &kp D  &kp F  &kp G  &kp H  &kp J        &kp K      &kp L          &kp SEMI
&mt LALT Z      &mt LSHFT X      &kp C  &kp V  &kp B  &kp N  &lt LOWER M  &kp COMMA  &mt LSHFT DOT  &mt RALT FSLH
                &lt MOUSE TAB  &mt LSHFT BSPC  &lt LOWER ESC  &mt LCTRL RET  &lt RAISE SPACE  &kp LGUI
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp LS(N1)    &kp HOME      &kp UP      &kp END       &kp LS(N5)    &none         &kp F1     &kp F2     &kp F3  &kp F4
&kp N1        &kp LEFT      &kp DOWN    &kp RIGHT     &kp N5        &none         &kp F4     &kp F5     &kp F7  &kp F11
&kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_BRI_UP  &out OUT_TOG  &kp F1     &kp F2     &kp F3  &kp F12
                            &trans      &trans        &trans        &mkp LCLK     &mkp RCLK  &mkp MCLK
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp LS(N1)  &kp LS(N2)     &kp LS(N3)    &kp LS(N4)      &kp LS(N5)  &kp LS(KP_PLUS)  &kp N7  &kp N8  &kp N9  &kp PSCRN
&kp GRAVE   &kp LS(GRAVE)  &kp LS(BSLH)  &kp LS(N7)      &kp LS(N6)  &kp LS(N8)       &kp N4  &kp N5  &kp N6  &kp MINUS
&kp BSLH    &kp C_PREV     &kp LS(C_PP)  &kp LS(C_NEXT)  &bt BT_CLR  &kp N0           &kp N1  &kp N2  &kp N3  &kp DOT
                           &kp LS(TAB)   &kp BSPC        &kp DEL     &trans           &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&bt BT_SEL 3  &kp HOME   &kp UP     &kp END    &bt BT_SEL 2  &kp PG_UP       &kp LBKT      &kp RBKT      &none     &kp EQUAL
&bt BT_SEL 4  &kp LEFT   &kp DOWN   &kp RIGHT  &bt BT_SEL 1  &kp PG_DN       &kp LS(N9)    &kp LS(N0)    &kp SQT   &kp LS(SEMI)
&kp LALT      &mkp MCLK  &mkp RCLK  &mkp LCLK  &bt BT_SEL 0  &studio_unlock  &kp LS(LBKT)  &kp LS(RBKT)  &none     &kp LS(MINUS)
                         &none      &kp LSHFT  &none         &kp RET         &kp SPACE     &trans
            >;
        };
    };
};
