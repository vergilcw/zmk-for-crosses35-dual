/*
 * Crosses 35 dual-trackball keymap.
 *
 * Bindings were exported from the keyboard's ZMK Studio state on 2026-10-10
 * (scripts/studio_dump.py -> scripts/studio_to_keymap.py; raw snapshot in
 * docs/studio-snapshots/). Studio-saved bindings in flash override this file
 * until "Restore Stock Settings" is run in ZMK Studio — see docs/flashing.md.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define MOUSE 3

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q           &kp W            &kp E  &kp R  &kp T  &kp Y  &kp U        &kp I      &kp O          &kp P
&kp A           &kp S            &kp D  &kp F  &kp G  &kp H  &kp J        &kp K      &kp L          &kp SQT
&mt LALT Z      &mt LSHFT X      &kp C  &kp V  &kp B  &kp N  &lt LOWER M  &kp COMMA  &mt LSHFT DOT  &mt RALT FSLH
                &lt MOUSE TAB  &mt LSHFT BSPC  &lt LOWER ESC  &mt LCTRL RET  &lt RAISE SPACE  &kp LGUI
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp LS(N1)    &kp HOME      &kp UP      &kp END       &kp LS(N5)    &none         &kp F1     &kp F2     &kp F3  &kp F4
&kp N1        &kp LEFT      &kp DOWN    &kp RIGHT     &kp N5        &none         &kp F4     &kp F5     &kp F7  &kp F11
&kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_BRI_UP  &out OUT_TOG  &kp F1     &kp F2     &kp F3  &kp F12
                            &trans      &trans        &trans        &mkp LCLK     &mkp RCLK  &mkp MCLK
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp LS(N1)  &kp LS(N2)     &kp LS(N3)    &kp LS(N4)      &kp LS(N5)  &kp LS(KP_PLUS)  &kp N7  &kp N8  &kp N9  &kp PSCRN
&kp GRAVE   &kp LS(GRAVE)  &kp LS(BSLH)  &kp LS(N7)      &kp LS(N6)  &kp LS(N8)       &kp N4  &kp N5  &kp N6  &kp MINUS
&kp BSLH    &kp C_PREV     &kp LS(C_PP)  &kp LS(C_NEXT)  &bt BT_CLR  &kp N0           &kp N1  &kp N2  &kp N3  &kp DOT
                           &kp LS(TAB)   &kp BSPC        &kp DEL     &trans           &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&bt BT_SEL 3  &kp HOME   &kp UP     &kp END    &bt BT_SEL 2  &kp PG_UP       &kp LBKT      &kp RBKT      &none     &kp EQUAL
&bt BT_SEL 4  &kp LEFT   &kp DOWN   &kp RIGHT  &bt BT_SEL 1  &kp PG_DN       &kp LS(N9)    &kp LS(N0)    &kp SEMI  &kp LS(SEMI)
&kp LALT      &mkp MCLK  &mkp RCLK  &mkp LCLK  &bt BT_SEL 0  &studio_unlock  &kp LS(LBKT)  &kp LS(RBKT)  &none     &kp LS(MINUS)
                         &none      &kp LSHFT  &none         &kp RET         &kp SPACE     &trans
            >;
        };
    };
};
