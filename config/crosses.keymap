/*
 * Crosses 35 dual-trackball keymap.
 *
 * No Q+W combo; ' stays on the Base right pinky (not swapped with ;, unlike Crosses 36).
 *
 * Bindings were exported from the keyboard's ZMK Studio state on 2026-10-10
 * (scripts/studio_dump.py -> scripts/studio_to_keymap.py; raw snapshot in
 * docs/studio-snapshots/). Studio-saved bindings in flash override this file
 * until "Restore Stock Settings" is run in ZMK Studio — see docs/flashing.md.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors/rotate_plane.dtsi>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define MOUSE  3
#define LMOUSE 4
#define RMOUSE 5

/*
 * Trackball behaviour by layer ("rot" = rotated, 0 deg = unrotated):
 *
 *   layer          right ball (central)          left ball (via split)
 *   Base           pointer, rot 45 CCW           vertical-only scroll, 0 deg
 *   Lower          vertical-only scroll, 0 deg   vertical-only scroll, 0 deg
 *   Raise          snipe (1/4), rot 45 CCW       horizontal-only scroll, rot 45 CW
 *   Mouse/RMouse   pointer, rot 45 CCW           vertical-only scroll, 0 deg
 *
 * Right-ball Lower scroll is Y-inverted; the left ball's plain scroll is not, because its sensor reads
 * both axes flipped (hardware tests, 2026-10-24/25).
 *   LMouse         pointer, rot 45 CCW           pointer, rot 45 CW (module angle 135, see below)
 *
 * The rotate-plane processors are separate devices, so each ball is a two-stage chain: a stage-1
 * listener (layer children choose whether to rotate or to short-circuit) and a stage-2 listener that
 * reads the rotated events and applies the layer behaviour. Module angle +45 = counterclockwise (what
 * the Crosses 36 repo calls -45); the left ball is the mirror image (-45) plus 180 deg because its sensor reads
 * both axes flipped relative to the right ball (hardware test, 2026-10-24) = 135.
 */

/* Right ball. Base: rotate -> stage 2. Lower: unrotated vertical scroll, no stage 2. */
&zip_rotate_pointer {
    angle = <45>;
};

&trackball_central_listener {
    input-processors = <&zip_rotate_pointer>;

    /* First match wins. Lower beats the mouse layers so holding a mouse layer-tap and then Lower scrolls. */
    lower_vscroll {
        layers = <LOWER>;
        input-processors = <&zip_x_scaler 0 1>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_scroll_scaler 1 32>, <&zip_ble_report_rate_limit>;
    };

    mouse_pointer {
        layers = <LMOUSE RMOUSE>;
        input-processors = <&zip_rotate_pointer>;
    };
};

/* Left ball: the left half only rate-limits and sends raw X/Y; everything else happens on the central. */
&trackball_peripheral_split {
    input-processors = <&zip_ble_report_rate_limit>;
};

/* Base/Lower/Mouse/RMouse: unrotated vertical-only scroll. LMouse and Raise: rotate -> stage 2. */
&trackball_peripheral_listener {
    input-processors = <&zip_x_scaler 0 1>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 32>;

    /* Lower beats LMouse: hold C (LMouse), then V (Lower) to scroll with the left ball. */
    lower_scroll {
        layers = <LOWER>;
        input-processors = <&zip_x_scaler 0 1>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 32>;
    };

    lmouse_rotate {
        layers = <LMOUSE>;
        input-processors = <&zip_rotate_left>;
    };

    raise_rotate {
        layers = <RAISE>;
        input-processors = <&zip_rotate_left>;
    };
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    /* Right ball stage 2: pointer by default, snipe on Raise. */
    rotated_pointer_listener {
        compatible = "zmk,input-listener";
        device = <&zip_rotate_pointer>;
        input-processors = <&zip_ble_report_rate_limit>;

        raise_snipe {
            layers = <RAISE>;
            input-processors = <&zip_xy_scaler 1 4>, <&zip_ble_report_rate_limit>;
        };
    };

    zip_rotate_left: zip_rotate_left {
        compatible = "zmk,input-processor-rotate-plane";
        device-name = "left";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        angle = <135>; /* mirrored -45, plus 180: the left ball is mounted rotated 180 deg from the right one */
    };

    /* Left ball stage 2 (only LMouse and Raise get here): pointer by default, horizontal-only scroll on Raise. */
    left_ball_listener {
        compatible = "zmk,input-listener";
        device = <&zip_rotate_left>;

        raise_hscroll {
            layers = <RAISE>;
            input-processors = <&zip_y_scaler 0 1>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 32>;
        };
    };

    /* J+K -> Esc ("just kidding"). Idle guard keeps fast rolls through j/k from firing it. */
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q       &kp W        &kp E         &kp R        &kp T  &kp Y  &kp U        &kp I             &kp O          &kp P
&kp A       &kp S        &kp D         &kp F        &kp G  &kp H  &kp J        &kp K             &kp L          &kp SEMI
&mt LALT Z  &mt LSHFT X  &lt LMOUSE C  &lt LOWER V  &kp B  &kp N  &lt LOWER M  &lt RMOUSE COMMA  &mt LSHFT DOT  &mt LALT FSLH
                         &lt MOUSE TAB  &mt LSHFT BSPC  &lt LOWER DEL  &mt LCTRL RET  &lt RAISE SPACE  &kp LGUI
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp LS(N1)    &kp PSCRN     &bt BT_SEL 4  &bt BT_SEL 3  &kp LS(N5)    &bt BT_CLR    &kp F7  &kp F8  &kp F9  &kp F10
&kp N1        &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp N5        &none         &kp F4  &kp F5  &kp F6  &kp F11
&kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP  &kp C_BRI_UP  &out OUT_TOG  &kp F1  &kp F2  &kp F3  &kp F12
                            &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp LS(N1)  &kp LS(N2)     &kp LS(N3)    &kp LS(N4)  &kp LS(N5)  &kp LS(EQUAL)  &kp N7  &kp N8  &kp N9  &kp COLON
&kp GRAVE   &kp LS(GRAVE)  &kp LS(BSLH)  &kp LS(N7)  &kp LS(N6)  &kp LS(N8)     &kp N4  &kp N5  &kp N6  &kp MINUS
&kp BSLH    &mkp MCLK      &mkp RCLK     &mkp LCLK   &none       &kp N0         &kp N1  &kp N2  &kp N3  &kp DOT
                           &kp LS(TAB)  &kp BSPC  &kp DEL  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&kp PG_UP  &kp HOME   &kp UP     &kp END    &bt BT_SEL 2  &kp PG_UP       &kp LBKT      &kp RBKT      &none    &kp EQUAL
&kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &bt BT_SEL 1  &kp PG_DN       &kp LS(N9)    &kp LS(N0)    &kp SQT  &kp LS(SQT)
&kp LALT   &mkp MCLK  &mkp RCLK  &mkp LCLK  &bt BT_SEL 0  &studio_unlock  &kp LS(LBKT)  &kp LS(RBKT)  &none    &kp LS(MINUS)
                      &none  &kp LSHFT  &none  &kp RET  &kp SPACE  &trans
            >;
        };

        lmouse_layer {
            display-name = "LMouse";
            bindings = <
&none  &none  &none  &none      &none  &none  &kp HOME   &kp UP     &kp END    &kp PG_UP
&none  &none  &none  &none      &none  &none  &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN
&none  &none  &none  &mo LOWER  &none  &none  &mkp LCLK  &mkp RCLK  &mkp MCLK  &none
              &mkp MCLK  &mkp RCLK  &mkp LCLK  &kp LCTRL  &kp LSHFT  &none
            >;
        };

        rmouse_layer {
            display-name = "RMouse";
            bindings = <
&kp PG_UP  &kp HOME   &kp UP     &kp END    &none  &none  &none      &none  &none  &none
&kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &none  &none  &none      &none  &none  &none
&none      &mkp MCLK  &mkp RCLK  &mkp LCLK  &none  &none  &mo LOWER  &none  &none  &none
                      &none  &kp LSHFT  &kp LCTRL  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };
    };
};
